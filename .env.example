# ─── Telegram Bot Configuration ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated admin user IDs (first one is super admin)
ADMIN_USER_IDS=
# Optional: restrict bot to specific user IDs (comma-separated). Leave empty = public.
ALLOWED_USER_IDS=

# ─── Pollinations AI Configuration ───
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
# Optional: get free key from https://auth.pollinations.ai (raises rate limits)
POLLINATIONS_API_KEY=

# ─── Bot Behavior ───
# Default language: en or ar
DEFAULT_LANGUAGE=en
# Per-user rate limit: seconds between requests
RATE_LIMIT_SECONDS=5
# Max conversation turns kept in memory per user
MAX_HISTORY_TURNS=10
# Default text model
DEFAULT_TEXT_MODEL=gpt-5.4-mini
# Default image model (turbo = fast/free, flux = higher quality)
DEFAULT_IMAGE_MODEL=turbo
# Default TTS voice
DEFAULT_TTS_VOICE=Rachel
